# Backend (copy to backend/.env). Placeholders only - never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career_coach
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
API_TIMEOUT=30
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_HOST=
CHROMA_PORT=8000
JWT_SECRET_KEY=            # >= 32 random chars in production (python -c "import secrets;print(secrets.token_urlsafe(48))")
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_ATTEMPTS_PER_15_MIN=10
REGISTRATIONS_PER_IP_PER_HOUR=10
EMBEDDING_PROVIDER=local-hf   # "hash" = lexical dev/test only; local-hf needs requirements-local-embeddings.txt
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=5
GUEST_SESSION_EXPIRE_MINUTES=60
MAX_REQUESTS_PER_SESSION=50
GUEST_MAX_DOCUMENTS=10
GUEST_SESSIONS_PER_IP_PER_HOUR=20
MAX_CONCURRENT_INGESTIONS=2
MAX_REPORT_BYTES=5242880
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=3
MAX_CONTEXT_CHARS=12000
MAX_DOCUMENT_CHARS=100000
MAX_PDF_PAGES=50
CHROMA_PERSIST_PATH=chroma_db
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=false
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_PATH=storage

# Frontend (frontend/.env) - the only variable exposed to the browser
# VITE_API_BASE_URL=http://127.0.0.1:8000
